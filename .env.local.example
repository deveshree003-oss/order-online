# Public Supabase credentials only. Do not put a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional: an existing Supabase Storage bucket for admin product images.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images
# Used by the scheduled four-month product cleanup route.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
CRON_SECRET=your_cron_secret
